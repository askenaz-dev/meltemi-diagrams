{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Meltemi Diagrams",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode",
        "${workspaceFolder}/examples"
      ],
      "outFiles": ["${workspaceFolder}/packages/vscode/dist/**/*.cjs"],
      "preLaunchTask": "Build Meltemi Diagrams extension"
    }
  ]
}
