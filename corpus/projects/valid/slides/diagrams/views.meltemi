language "0.2"

// The checkout flow that the slide links to.
diagram checkout: flow {
  layout manual

  client["Client"]
  api["API Gateway"]
  data orders "Orders"

  client -> api: "HTTPS" as request
  api -> orders: "SQL" as persist

  placement {
    place client at (120, 60)
    place api at (360, 60)
    place orders at (600, 60)
  }
}
