language "0.2"

// A negative gap closer than the heads allow: the label between them wraps to the room left, but
// the heads keep their floor and the layout says how far apart it drew them.
diagram checkout: sequence {
  participant customer "Customer"
  participant api "API"

  customer -> api: "Place the order with every item" as order

  placement {
    gap api -120
  }
}
