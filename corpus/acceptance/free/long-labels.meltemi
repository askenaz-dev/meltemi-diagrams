language "0.2"

// Long labels on a slide: a long heading and subtitle, boxes sized for long names and
// descriptions, and connectors with long labels.
diagram longLabels: free {
  title "Arquitectura de referencia para pagos con tarjeta"
  preset slide
  layout manual

  text heading "Arquitectura de referencia para pagos con tarjeta"
  text subtitle "Del comercio al banco emisor, con conciliación diaria y devoluciones parciales"

  box merchant "Terminal del comercio en tienda" { description "Lee la tarjeta y firma el cargo" }
  box gateway "Pasarela de autorización y riesgo" { description "Valida firmas, límites y fraude" }
  box issuer "Banco emisor de la tarjeta" { description "Autoriza o rechaza el cargo" }
  box ledger "Libro mayor de conciliación diaria" { description "Cuadra cada liquidación" }

  merchant -> gateway: "Envía el cargo firmado" as send
  gateway -> issuer: "Pide la autorización del titular" as authorize
  gateway -> ledger: "Registra el resultado y la comisión" as record

  placement {
    place heading at (960, 100)
    place subtitle at (960, 160)
    place merchant at (340, 480)
    size merchant (360, 96)
    place gateway at (960, 480)
    size gateway (360, 96)
    place issuer at (1580, 480)
    size issuer (360, 96)
    place ledger at (960, 820)
    size ledger (400, 96)
  }
}
