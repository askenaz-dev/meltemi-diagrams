language "0.2"

// Containers and stacks drawn as in a visual editor: three plain square containers nested in each
// other, three boxes stacked outer first, and a band on a back layer behind boxes the engine
// arranges.
diagram stacked: free {
  title "Containers, stacks and bands"
  preset slide
  layout assisted
  direction LR
  layers back, main

  text heading "Containers, stacks and bands"

  // Plain containers: untitled groups, filled and square.
  group blue "" {
    group pink "" {
      group yellow "" {
        box core "Core"
      }
    }
  }
  text containers "Nested containers"

  // A stack: the outer box first, so the inner ones paint over it.
  box base ""
  box tray ""
  box chip ""
  text stack "A stack of boxes"

  // A band behind the boxes the engine arranges: placed and sized, on the back layer.
  group band "" { layer back }
  box intake "Intake"
  box review "Review"
  box archive "Archive"
  text lane "A band behind arranged boxes"

  core -> chip: "feeds" as feed
  chip -> intake: "hands over" as handover
  intake -> review as check
  review -> archive as keep

  placement {
    place heading at (960, 110)
    place blue at (360, 480)
    size blue (480, 400)
    place pink at (224, 184)
    size pink (400, 320)
    place yellow at (184, 144)
    size yellow (320, 240)
    place core at (144, 104)
    place containers at (360, 730)
    place base at (860, 480)
    size base (260, 240)
    place tray at (860, 480)
    size tray (210, 180)
    place chip at (860, 480)
    size chip (150, 130)
    place stack at (860, 730)
    place band at (1456, 480)
    size band (680, 160)
    place lane at (1456, 730)
  }

  style blue { fill "#dae8fc"; stroke "#6c8ebf"; radius 0 }
  style pink { fill "#f8cecc"; stroke "#b85450"; radius 0 }
  style yellow { fill "#fff2cc"; stroke "#d6b656"; radius 0 }
  style base { fill "#d5e8d4"; stroke "#82b366" }
  style tray { fill "#e1d5e7"; stroke "#9673a6" }
  style chip { fill "#ffe6cc"; stroke "#d79b00" }
  style band { fill "#f5f5f5"; stroke "#666666"; line dashed; radius 0 }
}
