language "0.2"

// Text sizes, weights and fonts in a free composition (decision 0067): a heading, boxes in a
// serif, a monospace and a sans family, a sticky in a hand font, and a note.
diagram typography: free {
  title "Typography"
  layout manual

  text heading "Release notes"
  box serif "Merriweather heading" { description "Serif body" }
  box mono "npm run build"
  box sans "Montserrat, bold"
  sticky idea "Ship the fonts first"
  note remark "Measured with the bundled fonts"

  placement {
    place heading at (360, 40)
    place serif at (160, 160)
    size serif (240, 72)
    place mono at (460, 160)
    size mono (200, 56)
    place sans at (720, 160)
    size sans (220, 56)
    place idea at (200, 360)
    place remark at (520, 340)
  }

  style heading { font "Playfair Display"; fontSize 32; fontWeight 700 }
  style serif { font "Merriweather" }
  style mono { font "Roboto Mono"; fontSize 14 }
  style sans { font "Montserrat"; fontWeight 700 }
  style idea { font "Caveat"; fontSize 24 }
  style remark { font "Nunito"; fontSize 12 }
}
