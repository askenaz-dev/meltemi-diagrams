{
  "description": "Spacing, gaps, label offsets, tags and activations never change the order of the messages.",
  "sheet": "sequence/parallel.meltemi",
  "steps": [
    {
      "name": "space a message",
      "operation": {
        "kind": "setSpacing",
        "diagram": "parallel",
        "target": "reserved2",
        "targetKind": "event",
        "amount": 24
      },
      "changed": [
        "^\\s*space reserved2 24$",
        "^\\s*placement \\{$|^\\s*\\}$|space"
      ],
      "order": "parallel"
    },
    {
      "name": "widen a gap",
      "operation": {
        "kind": "setSpacing",
        "diagram": "parallel",
        "target": "inventory",
        "targetKind": "participant",
        "amount": 80
      },
      "changed": [
        "gap inventory"
      ],
      "order": "parallel"
    },
    {
      "name": "lift a label",
      "operation": {
        "kind": "setLabelAnchor",
        "diagram": "parallel",
        "relation": "reserved1",
        "at": 50,
        "offset": {
          "x": 0,
          "y": -6
        }
      },
      "changed": [
        "label reserved1"
      ],
      "order": "parallel"
    },
    {
      "name": "tag a message",
      "operation": {
        "kind": "addTag",
        "diagram": "parallel",
        "target": "reserve1",
        "targetKind": "relation",
        "text": "idempotent"
      },
      "changed": [
        "^\\s*store -> inventory: \"Reserve item 1\" as reserve1( \\{ tag \"idempotent\" \\})?$"
      ],
      "present": [
        "as reserve1 \\{ tag \"idempotent\" \\}\\n"
      ],
      "order": "parallel"
    },
    {
      "name": "tag a participant",
      "operation": {
        "kind": "addTag",
        "diagram": "parallel",
        "target": "inventory",
        "targetKind": "element",
        "text": "external"
      },
      "changed": [
        "^\\s*participant inventory \"Inventory\"( \\{ tag \"external\" \\})?$"
      ],
      "present": [
        "participant inventory \"Inventory\" \\{ tag \"external\" \\}\\n"
      ],
      "order": "parallel"
    },
    {
      "name": "activate the receiver",
      "operation": {
        "kind": "toggleActivation",
        "diagram": "parallel",
        "participant": "inventory",
        "after": "reserve1"
      },
      "changed": [
        "^\\s*activate inventory$",
        "^\\s*deactivate inventory$"
      ],
      "present": [
        "as reserve1 \\{ tag \"idempotent\" \\}\\n\\s*activate inventory\\n",
        "as reserved1\\n\\s*deactivate inventory\\n"
      ],
      "order": "parallel"
    },
    {
      "name": "remove the activation with its end",
      "operation": {
        "kind": "removeEvent",
        "diagram": "parallel",
        "event": "activate#1"
      },
      "changed": [
        "^\\s*activate inventory$",
        "^\\s*deactivate inventory$"
      ],
      "absent": [
        "(de)?activate inventory"
      ],
      "order": "parallel"
    }
  ]
}
