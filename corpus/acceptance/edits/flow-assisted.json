    },
    {
      "name": "connect it",
      "operation": {
        "kind": "createRelation",
        "diagram": "shop",
        "from": "api",
        "to": "audit",
        "line": "solid",
        "label": "records"
      },
      "changed": [
        "api -> audit"
      ],
      "unmoved": {
        "shop": [
          "web",
          "api"
        ]
      }
    }
  ]
}
