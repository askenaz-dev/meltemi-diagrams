language "0.2"

// Lists: a column that centres its boxes, a row of columns stretched to one height (a board), a
// row nested in a column, and a pen inside a column that keeps its points: a tick drawn on a card.
diagram lists: free {
  title "Lists"
  layout manual

  text heading "Lists"

  group steps "A column" {
    layout column
    spacing 12
    align center
    box plan "Plan"
    box build "Build and test the first version"
    box ship "Ship"
  }

  group board "" {
    layout row
    spacing 24
    align stretch

    group todo "To do" {
      layout column
      spacing 12
      sticky brief "Write the brief"
      group parts "" {
        layout row
        spacing 8
        box api "API"
        box ui "UI"
      }
    }

    group done "Done" {
      layout column
      spacing 12
      sticky name "Pick a name"
      pen check [(118, 22), (128, 34), (150, 8)]
    }
  }

  placement {
    place heading at (400, 40)
    place steps at (150, 250)
    place board at (560, 260)
    size api (72, 40)
    size ui (72, 40)
  }

  style heading { fontSize 28; fontWeight 700 }
  style brief { fill "#bbdefb" }
  style name { fill "#c8e6c9" }
  style parts { stroke line; line dashed }
  style check { stroke success; width 4 }
}
