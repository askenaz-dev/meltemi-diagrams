language "0.2"

// Shared model and views from the product proposal ("Modelos y vistas"), with a context view and
// a component view that lift and combine the model's relations.
model commerce {
  person customer "Cliente" { description "Compra en línea" }

  system shop "Commerce" {
    description "Tienda en línea"
    container web "Web" { technology "React" }
    container api "API" {
      technology "HTTP"
      component orders "Pedidos" { technology "Kotlin" }
      component payments "Pagos" { technology "Kotlin" }
    }
    datastore db "Pedidos" { technology "PostgreSQL" }
    api.orders -> db: "Guarda" as store
  }
  system bank "Banco" {
    description "Autoriza tarjetas"
    external
  }

  customer -> shop.web: "Compra" as visit
  shop.web -> shop.api: "HTTPS" as request { technology "JSON/HTTPS" }
  shop.api -> shop.db: "SQL" as persist
  shop.api.payments -> bank: "Autoriza" as authorize
  shop.web -> shop.api.orders: "Pedidos" as orders
}

diagram context: c4 using commerce {
  level context
  title "Commerce en contexto"
}

diagram containers: c4 using commerce {
  level container
  scope shop
  include customer, shop.web, shop.api, shop.db
  direction LR
  layout assisted
  theme "editorial.light"
  label shop.api "API de pedidos"
  note cache "Cached 5 min" on shop.api
}

diagram components: c4 using commerce {
  level component
  scope shop.api
  shop.web -> shop.api.orders: "Usa" as uses
}
