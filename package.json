{
  "name": "dac-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Meltemi Diagrams: diagrams as code, canvas editing and animated exports.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx --conditions=@meltemi/diagrams-source packages/acceptance/src/bench.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "mdg": "tsx --conditions=@meltemi/diagrams-source packages/cli/src/bin.ts",
    "preview": "node scripts/preview-server.mjs 4173 .",
    "skills:sync": "node scripts/sync-skills.mjs",
    "import:docs": "tsx --conditions=@meltemi/diagrams-source scripts/import-docs.ts",
    "vendor:icons": "tsx --conditions=@meltemi/diagrams-source scripts/vendor-icons.ts",
    "licenses:inventory": "node scripts/licenses.mjs",
    "vscode:build": "tsx --conditions=@meltemi/diagrams-source packages/vscode/build.mjs",
    "vscode:package": "pnpm --filter meltemi-diagrams run package",
    "vscode:test": "tsx --conditions=@meltemi/diagrams-source packages/vscode/build.mjs && node packages/vscode/test/vscode/run.mjs",
    "vscode:test-webview": "tsx --conditions=@meltemi/diagrams-source packages/vscode/build.mjs && tsx --conditions=@meltemi/diagrams-source packages/vscode/test/webview/run.ts",
    "player:test-browser": "tsx --conditions=@meltemi/diagrams-source packages/player/test/browser/run.ts",
    "catalog:test-browser": "tsx --conditions=@meltemi/diagrams-source packages/catalog/test/browser/run.ts",
    "playground:build": "tsx --conditions=@meltemi/diagrams-source packages/playground/build.mjs",
    "playground:test-browser": "tsx --conditions=@meltemi/diagrams-source packages/playground/build.mjs && tsx --conditions=@meltemi/diagrams-source packages/playground/test/browser/run.ts",
    "assist:guide": "node scripts/assist-guide.mjs",
    "acceptance": "pnpm playground:build && tsx --conditions=@meltemi/diagrams-source packages/acceptance/src/run-all.ts",
    "acceptance:visual": "tsx --conditions=@meltemi/diagrams-source packages/acceptance/src/visual.ts",
    "acceptance:determinism": "tsx --conditions=@meltemi/diagrams-source packages/acceptance/src/determinism.ts",
    "acceptance:first-export": "pnpm playground:build && tsx --conditions=@meltemi/diagrams-source packages/acceptance/src/first-export.ts",
    "verification:browsers": "tsx --conditions=@meltemi/diagrams-source packages/acceptance/src/browsers.ts",
    "verification:kit": "tsx --conditions=@meltemi/diagrams-source packages/acceptance/src/kit.ts",
    "pilot:summary": "node scripts/pilot-summary.mjs",
    "release:version": "node scripts/release-version.mjs",
    "gallery": "tsx --conditions=@meltemi/diagrams-source packages/acceptance/src/gallery.ts",
    "demo": "pnpm playground:build && tsx --conditions=@meltemi/diagrams-source packages/acceptance/src/demo.ts",
    "conformance": "tsx --conditions=@meltemi/diagrams-source packages/acceptance/src/conformance.ts",
    "release:check": "tsx --conditions=@meltemi/diagrams-source packages/acceptance/src/release-check.ts",
    "cloud:dev": "pnpm playground:build && pnpm --filter @meltemi/diagrams-cloud run dev",
    "cloud:migrate": "pnpm --filter @meltemi/diagrams-cloud run migrate",
    "cloud:test": "vitest run packages/cloud",
    "cloud:test-browser": "tsx packages/cloud/test/browser/run.ts",
    "cloud:dev-session": "tsx packages/cloud/test/dev-session.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
