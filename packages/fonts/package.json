{
  "name": "@meltemi/diagrams-fonts",
  "version": "1.9.0",
  "description": "Bundled OFL fonts, text measurement, font subsetting and text outlines for Meltemi Diagrams.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askenaz-dev/meltemi-diagrams.git",
    "directory": "packages/fonts"
  },
  "homepage": "https://github.com/askenaz-dev/meltemi-diagrams/tree/main/packages/fonts#readme",
  "bugs": {
    "url": "https://github.com/askenaz-dev/meltemi-diagrams/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "@meltemi/diagrams-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "@meltemi/diagrams-source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource/cascadia-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@ibm/plex-sans": "1.1.0",
    "@meltemi/diagrams-i18n": "workspace:*",
    "fontkit": "2.0.4",
    "inter-ui": "4.1.1"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      }
    }
  }
}
