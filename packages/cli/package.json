{
  "name": "@meltemi/diagrams-cli",
  "version": "1.8.0",
  "description": "Command line interface (meltemi-diagrams, alias mdg) for .meltemi projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askenaz-dev/meltemi-diagrams.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/askenaz-dev/meltemi-diagrams/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/askenaz-dev/meltemi-diagrams/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "bin": {
    "meltemi-diagrams": "./dist/bin.js",
    "mdg": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "@meltemi/diagrams-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@meltemi/diagrams-assets": "workspace:*",
    "@meltemi/diagrams-assist": "workspace:*",
    "@meltemi/diagrams-capture": "workspace:*",
    "@meltemi/diagrams-catalog": "workspace:*",
    "@meltemi/diagrams-edit": "workspace:*",
    "@meltemi/diagrams-editor": "workspace:*",
    "@meltemi/diagrams-fonts": "workspace:*",
    "@meltemi/diagrams-i18n": "workspace:*",
    "@meltemi/diagrams-import": "workspace:*",
    "@meltemi/diagrams-language": "workspace:*",
    "@meltemi/diagrams-layout": "workspace:*",
    "@meltemi/diagrams-layout-elk": "workspace:*",
    "@meltemi/diagrams-model": "workspace:*",
    "@meltemi/diagrams-motion": "workspace:*",
    "@meltemi/diagrams-player": "workspace:*",
    "@meltemi/diagrams-project": "workspace:*",
    "@meltemi/diagrams-render": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
