language "0.2"

// A launch plan: three sections of tasks scheduled from dates and from what they wait for, the
// weekends and a holiday not worked, tasks of every status, a critical chain, a milestone, a marker
// and the story of the plan. `today` is pinned so that the picture is the same on every day.
diagram plan: gantt {
  title "Mobile app launch"
  description "Three sections of tasks with their dependencies, a milestone and a marker"
  theme "editorial.light"
  axisFormat "%d %b"
  exclude weekends, 2026-07-03
  today 2026-06-17

  section research "Research" {
    task market "Market scan" from 2026-06-01 for 4d done
    task users "User interviews" from 2026-06-02 for 6d done
    task brief "Product brief" after market, users for 2d done critical
  }

  section build "Build" {
    task ux "Interaction design" after brief for 7d active critical
    task api "API" after brief for 10d { description "Orders and payments" }
    task app "Mobile app" after ux for 9d critical
    task beta "Beta programme" after app for 5d
  }

  section release "Release" {
    task review "Store review" after app, api for 3d critical
    milestone live "In the stores" after review critical
    task support "Launch support" after live for 2w
  }

  marker freeze "Feature freeze" at 2026-07-01
}

// The plan told one section at a time, then the chain that sets the launch date.
story tell for plan {
  scene research "Research" {
    reveal research
    draw market, users, brief over 2s
  }

  scene build "Build" {
    reveal build
    draw ux, api, app, beta over 2s
  }

  scene chain "The chain to the launch" {
    reveal release, freeze
    trace live over 2s
  }
}
