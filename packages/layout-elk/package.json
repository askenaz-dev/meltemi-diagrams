{
  "name": "@meltemi/diagrams-layout-elk",
  "version": "1.9.0",
  "description": "The ELK layout engine adapter of Meltemi Diagrams (ELK is EPL-2.0).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askenaz-dev/meltemi-diagrams.git",
    "directory": "packages/layout-elk"
  },
  "homepage": "https://github.com/askenaz-dev/meltemi-diagrams/tree/main/packages/layout-elk#readme",
  "bugs": {
    "url": "https://github.com/askenaz-dev/meltemi-diagrams/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "@meltemi/diagrams-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@meltemi/diagrams-layout": "workspace:*",
    "elkjs": "0.12.0"
  },
  "devDependencies": {
    "@meltemi/diagrams-model": "workspace:*",
    "esbuild": "0.28.2"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
