{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Meltemi Diagrams",
  "scopeName": "source.meltemi",
  "fileTypes": ["meltemi"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#arrows" },
    { "include": "#declaration-shorthand" },
    { "include": "#diagram-header" },
    { "include": "#keywords" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.meltemi",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.meltemi",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.meltemi",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        { "name": "constant.character.escape.meltemi", "match": "\\\\[\"\\\\nt]" },
        { "name": "constant.other.color.meltemi", "match": "#[0-9A-Fa-f]{3,8}\\b" }
      ]
    },
    "numbers": {
      "name": "constant.numeric.meltemi",
      "match": "(?<![A-Za-z_])-?\\d+(?:\\.\\d+)?(?:px|ms|s|%)?\\b|(?<![A-Za-z_])-?\\d+(?:\\.\\d+)?%"
    },
    "arrows": {
      "name": "keyword.operator.arrow.meltemi",
      "match": "<-->|<->|-->|->|---|--"
    },
    "declaration-shorthand": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\[)",
      "captures": { "1": { "name": "entity.name.type.element.meltemi" } }
    },
    "diagram-header": {
      "match": "\\b(diagram)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*(flow|sequence|c4|free)\\b",
      "captures": {
        "1": { "name": "storage.type.diagram.meltemi" },
        "2": { "name": "entity.name.type.diagram.meltemi" },
        "3": { "name": "punctuation.separator.meltemi" },
        "4": { "name": "support.type.profile.meltemi" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "comment": "The icon shape: `shape icon`, where `icon` is a value, not the free object kind.",
          "match": "\\b(shape)\\s+(icon)\\b",
          "captures": {
            "1": { "name": "support.type.property-name.style.meltemi" },
            "2": { "name": "constant.language.meltemi" }
          }
        },
        {
          "comment": "A free line: `line <id> [\"Label\"] from …`, where `line` is the object kind, not the style property.",
          "match": "\\b(line)(?=\\s+[A-Za-z_][A-Za-z0-9_]*\\s+(?:\"(?:[^\"\\\\]|\\\\.)*\"\\s+)?from\\b)",
          "captures": { "1": { "name": "storage.type.element.meltemi" } }
        },
        {
          "name": "keyword.control.top-level.meltemi",
          "match": "\\b(language|import|from|as|diagram|theme|model|story|export|for|using)\\b"
        },
        {
          "name": "storage.type.element.meltemi",
          "match": "\\b(node|decision|data|group|note|tag|box|text|icon|image|port|layer|link|participant|actor|boundary|control|entity|database|collections|queue)\\b"
        },
        {
          "name": "keyword.control.block.meltemi",
          "match": "\\b(placement|style|animate|class|rule|extends|scenario)\\b"
        },
        {
          "name": "keyword.control.sequence.meltemi",
          "match": "\\b(activate|deactivate|create|destroy|alt|else|opt|loop|par|and|break|critical|option|region|divider|delay|choose|repeat|skip|take)\\b"
        },
        {
          "name": "keyword.other.sequence.meltemi",
          "match": "\\b(over|of|space|gap|kind)\\b"
        },
        {
          "name": "keyword.other.placement.meltemi",
          "match": "\\b(place|size|route|label|at|to|via|on|offset|align|row|column|order|distance)\\b"
        },
        {
          "name": "support.type.property-name.diagram.meltemi",
          "match": "\\b(direction|layout|routing|title|description|preset|canvas|layers|autonumber)\\b"
        },
        {
          "name": "support.type.property-name.style.meltemi",
          "match": "\\b(iconColor|iconPosition|labelPosition|iconSize|fill|stroke|color|line|width|pattern|arrowhead|arrowtail|corners|shape|radius|rotation|fontSize|fontWeight|textAlign|verticalAlign|effect|duration|repeat|delay|direction|particles)\\b"
        },
        {
          "name": "support.type.property-name.theme.meltemi",
          "match": "\\b(background|surface|ink|muted|connector|band|bandLine|tagText|accent|accentEnd|success|warning|danger|info|font|mono|labelSize|descriptionSize|groupTitleSize|noteSize|tagSize|relationLabelSize|frameSize|labelWeight|padding|groupPadding|groupHeader|margin|radius|groupRadius|strokeWidth|connectorWidth|arrowSize|corners|sketch|iconSize|frame|brand|mark|flowDuration|dashDuration|pulseDuration|traceDuration|selection|guide)\\b"
        },
        {
          "name": "constant.language.meltemi",
          "match": "\\b(LR|RL|TB|BT|auto|assisted|manual|document|slide|orthogonal|polyline|bezier|solid|dashed|dotted|none|triangleOutline|diamondOutline|circleOutline|circle|bar|many|oneOrMany|onlyOne|zeroOrOne|zeroOrMany|sharp|light|rough|hatch|dots|cross|triangle|open|left|top|bottom|right|middle|center|horizontal|vertical|north|south|east|west|flow|pulse|dash|forever|forward|reverse|footer|header|meltemi|sequence|c4|free|rounded|rectangle|square|ellipse|diamond|cylinder|pill|parallelogram|trapezoid|pentagon|hexagon|octagon|star|cloud|callout|arrow|framed|flag|agent|main|sync|async|context|svg|png|pdf|html|mp4|webm|gif|static|animated|embedded|outlined|system)\\b"
        },
        {
          "name": "keyword.control.profile.meltemi",
          "match": "\\b(level|scope|include|exclude|person|system|container|datastore|component|technology|external|url|assumption|scene|view|transition|cut|fade|morph|over|reveal|hide|hold|trace|highlight|parallel|focus|camera|all|format|scale|background|transparent|motion|fonts|scenario|fps|duration|file|autoplay|loop|embed)\\b"
        }
      ]
    },
    "identifiers": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(\\.)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "variable.other.element.meltemi" },
        "2": { "name": "punctuation.accessor.meltemi" },
        "3": { "name": "variable.other.property.port.meltemi" }
      }
    }
  }
}
