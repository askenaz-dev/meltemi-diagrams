{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meltemi-diagrams-cloud",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-15",
  "dev": { "port": 8788 },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
  },
  "assets": {
    "directory": "../playground/dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/_identity/*",
      "/_published/*",
      "/_sponsors/*",
      "/cli-auth",
      "/cli-auth/*",
      "/mcp",
      "/mcp/*",
      "/p/*",
      "/rooms/*",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meltemi-diagrams",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "meltemi-diagrams-blobs" }],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "ProjectRoom" },
      { "name": "RENDERERS", "class_name": "ProjectRenderer" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProjectRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["ProjectRenderer"] },
  ],
  "secrets_store_secrets": [
    {
      "binding": "FORMS_SECRET_STORE",
      "store_id": "00000000000000000000000000000000",
      "secret_name": "FORMS_SECRET",
    },
    {
      "binding": "IDENTITY_EVENTS_SECRET_STORE",
      "store_id": "00000000000000000000000000000000",
      "secret_name": "IDENTITY_EVENTS_SECRET",
    },
    {
      "binding": "ADMIN_SUBS_STORE",
      "store_id": "00000000000000000000000000000000",
      "secret_name": "ADMIN_SUBS",
    },
    {
      "binding": "SPONSORS_WEBHOOK_SECRET_STORE",
      "store_id": "00000000000000000000000000000000",
      "secret_name": "SPONSORS_WEBHOOK_SECRET",
    },
  ],
  "triggers": { "crons": ["0 3 * * SUN"] },
  "rules": [
    { "type": "Data", "globs": ["**/*.woff2", "**/*.woff"], "fallthrough": true },
    { "type": "Text", "globs": ["**/*.json"], "fallthrough": true },
  ],
  "alias": {
    "@meltemi/diagrams-assets": "../assets/src/index.ts",
    "@meltemi/diagrams-assist": "../assist/src/index.ts",
    "@meltemi/diagrams-capture": "../capture/src/index.ts",
    "@meltemi/diagrams-catalog": "../catalog/src/index.ts",
    "@meltemi/diagrams-edit": "../edit/src/index.ts",
    "@meltemi/diagrams-editor": "../editor/src/index.ts",
    "@meltemi/diagrams-fonts": "../fonts/src/index.ts",
    "@meltemi/diagrams-i18n": "../i18n/src/index.ts",
    "@meltemi/diagrams-language": "../language/src/index.ts",
    "@meltemi/diagrams-layout": "../layout/src/index.ts",
    "@meltemi/diagrams-layout/shapes": "../layout/src/shapes.ts",
    "@meltemi/diagrams-layout/viewport": "../layout/src/viewport.ts",
    "@meltemi/diagrams-layout-elk": "../layout-elk/src/index.ts",
    "@meltemi/diagrams-model": "../model/src/index.ts",
    "@meltemi/diagrams-motion": "../motion/src/index.ts",
    "@meltemi/diagrams-player": "../player/src/index.ts",
    "@meltemi/diagrams-player/runtime": "../player/src/runtime.ts",
    "@meltemi/diagrams-project": "../project/src/index.ts",
    "@meltemi/diagrams-render": "../render/src/index.ts",
  },
  "vars": {
    "ORIGIN": "https://diagrams.meltemi.dev",
    "IDENTITY_ISSUER": "https://id.meltemi.dev",
    "IDENTITY_JWKS_URL": "https://id.meltemi.dev/.well-known/jwks.json",
    "PUBLISH_HOST": "meltemi.page",
    "SPONSORS_ACCOUNT": "",
  },
}
